# The page changes often. Revalidate HTML on each visit so a new
# editor.js?v= link is picked up. Versioned assets stay cached by their
# full URL, including the ?v= query. Do not add a page cache in front of this.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|svg|png|jpe?g|webp|woff2|ttf)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.librecv\.org$ [NC]
  RewriteRule ^ https://librecv.org%{REQUEST_URI} [R=301,L]
  RewriteRule ^step-1/?$ index.html [L]
  RewriteRule ^step-2/?$ index.html [L]
  RewriteRule ^step-3/?$ index.html [L]
  RewriteRule ^editor/?$ index.html [L]
</IfModule>
