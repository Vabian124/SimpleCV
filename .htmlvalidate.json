{
  "extends": ["html-validate:recommended"],
  "rules": {
    "no-inline-style": "off",
    "prefer-native-element": "off",
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "tel-non-breaking": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "script-type": "off",
    "long-title": "off",
    "input-missing-label": "off"
  }
}
